# isoTar-v2 backend environment
#
# Copy to `.env`, fill in the secrets, and pass the file to the container:
#
#     cp .env.template .env
#     docker run -d --name isotar -p 8080:8080 \
#       --env-file .env \
#       -v /path/to/jobs:/opt/out/jobs \
#       frankfeng78/isotar-v2:"$(cat VERSION)"
#
# `.env` is git-ignored. Never commit it, paste it into an issue, or echo it in
# a shell log. Lines starting with `#` and blank lines are ignored by
# `--env-file`; values are taken literally (do not quote them).
#
# Everything below is optional. Leaving a section blank only disables that
# feature: without NCBI_API_KEY the verification endpoints return 503, and
# without ANTHROPIC_AUTH_TOKEN the model review step is not offered
# (GET /api/v1/verification/config reports `enabled` and `llm_review_available`).

# ---------------------------------------------------------------------------
# NCBI E-utilities (PubMed search for the literature verification)
# ---------------------------------------------------------------------------
# Get a key at https://www.ncbi.nlm.nih.gov/account/settings/ ("API Key
# Management"). The key lifts the E-utilities limit from 3 to 10 requests per
# second; the single-process verification worker stays under that.
NCBI_API_KEY=
# Contact address sent with every E-utilities call, as NCBI's usage policy asks.
NCBI_EMAIL=

# ---------------------------------------------------------------------------
# Anthropic-compatible gateway (model review of candidate papers)
# ---------------------------------------------------------------------------
# The review script (app_v1/verification/llm_review.py) uses the official
# Anthropic Python SDK, which reads these two variables itself.
#
# ANTHROPIC_BASE_URL is the root of your LiteLLM gateway, without a trailing
# slash and without `/v1`: the SDK appends `/v1/messages`. LiteLLM serves the
# Anthropic Messages API at that path.
ANTHROPIC_BASE_URL=https://litellm.example.org
# Your LiteLLM virtual key (usually `sk-...`). It is sent as
# `Authorization: Bearer <token>`, which is what LiteLLM expects.
# Do not use ANTHROPIC_API_KEY here: that is sent as an `x-api-key` header and
# is meant for direct access to api.anthropic.com.
ANTHROPIC_AUTH_TOKEN=
# Model name exactly as the gateway exposes it (check `/v1/models` on the
# gateway or the LiteLLM model list). Default: claude-opus-5-5
ISOTAR_VERIFICATION_MODEL=claude-opus-5-5

# ---------------------------------------------------------------------------
# Verification tuning (defaults shown; uncomment to change)
# ---------------------------------------------------------------------------
# Shared caches for all jobs (PubMed answers and model verdicts). Put this on a
# persistent volume so repeated queries are free across container restarts.
#ISOTAR_VERIFICATION_DIR=/opt/out/verification
# Refetch cached PubMed answers older than this many days (0 = keep forever)
#ISOTAR_PUBMED_CACHE_DAYS=0
# PMIDs kept per query
#ISOTAR_PUBMED_RETMAX=20
# Top-ranked triplets searched per job
#ISOTAR_VERIFICATION_MAX_TRIPLETS=500
# Papers the model reads per job (cached verdicts are not counted)
#ISOTAR_VERIFICATION_MAX_PAPERS=40
# Seconds allowed for the model review step
#ISOTAR_VERIFICATION_TIMEOUT=3600
# Genomes a verification may run on (search terms and symbol table are human)
#ISOTAR_VERIFICATION_GENOMES=hg19,hg38
# Celery queue name; must match app_supervisord.conf
#ISOTAR_VERIFICATION_QUEUE=verification

# ---------------------------------------------------------------------------
# General server settings (defaults shown; uncomment to change)
# ---------------------------------------------------------------------------
#ISOTAR_JOB_DIR=/opt/out/jobs
#ISOTAR_LOG_DIR=/opt/out
#ISOTAR_LOG_LEVEL=INFO
#ISOTAR_CORS_ORIGINS=*
#ISOTAR_MAX_CORES_PER_JOB=8
#ISOTAR_DEFAULT_CORES=8
#ISOTAR_MAX_CONCURRENT_JOBS=4
#ISOTAR_MAX_NETWORK_MIRNAS=20
#ISOTAR_MAX_VALIDATE_TARGETS=5000
#ISOTAR_NETWORK_RESTRICT_TO_PAIRS=false
